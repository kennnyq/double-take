{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "double-take-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Media ships with the Worker as static assets (free, no payment method needed).
  // `run_worker_first` sends every request through src/index.ts, so nothing in
  // build/ is reachable without the passcode or a signed URL. build/.assetsignore
  // (written by scripts/stage.ts) keeps the private archive/ out of the upload.
  "assets": { "directory": "../build", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "STORAGE": "assets" },

  // To move media to R2 later: enable R2, create the bucket, set STORAGE to "r2",
  // uncomment this, and run `npm run publish:remote`.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "double-take-media" }],

  // Secrets (never in this file): DEMO_PASSCODE, SIGNING_KEY.
  // Local: worker/.dev.vars. Cloud: `npx wrangler secret put <NAME>`.
}
