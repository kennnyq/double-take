{
  "name": "double-take",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "lucide-react": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "^1.65.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tailnet": "bash scripts/serve-tailnet.sh",
    "dev:auth": "bash scripts/dev-auth.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "media": "bash scripts/generate-media.sh",
    "key:check": "node scripts/annotate/annotate.ts models",
    "review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/review/server.ts",
    "review:publish-prepare": "python3 -I scripts/harvest/review_publish.py prepare",
    "review:publish-deploy": "python3 -I scripts/harvest/review_publish.py deploy",
    "worktree:env": "bash scripts/worktree-env.sh",
    "check": "tsc --noEmit && expo lint && npm test && npm --prefix worker test",
    "check:prod": "cd worker && BASE_URL=\"${BASE_URL:-https://double-take-api.double-take-api.workers.dev}\" DEMO_PASSCODE=\"$(sed -n 's/^DEMO_PASSCODE=//p' .prod.vars | tr -d '\\\"')\" npm run test:e2e",
    "e2e:space": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/hold-space.ts",
    "e2e:taps": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/double-tap.ts",
    "e2e:flow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/double-take-flow.ts",
    "e2e:scrub": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/scrub-bar.ts",
    "e2e:wheel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/panel-wheel.ts",
    "e2e:overlay": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/overlay-on-top.ts",
    "e2e:icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/icons-on-top.ts",
    "e2e:hint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/gesture-hint.ts",
    "e2e:game": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/timed-guess.ts"
  },
  "private": true
}
