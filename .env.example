# Copy to .env.local (git-ignored) and fill in to stream clips from the media Worker.
# Without these the feed plays the bundled placeholder clips only.
EXPO_PUBLIC_API_URL=https://double-take-api.<your-subdomain>.workers.dev
# Not a secret: EXPO_PUBLIC_* values are built into the app bundle.
EXPO_PUBLIC_DEMO_PASSCODE=

# Accounts (Supabase project `double-take`). Both are public by design: row level
# security protects the data. Without them the app runs in local mode: actions stay
# in memory and nothing asks you to sign in.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Dev builds only: the Worker's /dev/* test-account routes (`npm run dev:auth`).
EXPO_PUBLIC_DEV_AUTH_URL=http://<this-machine>.<tailnet>.ts.net:8788
